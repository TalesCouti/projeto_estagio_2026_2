{
  "name": "clinica-aurora-agendamentos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "client": "vite --host 0.0.0.0",
    "server": "node --watch server/src/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/src/index.js",
    "db:setup": "node server/src/setupDb.js",
    "db:seed": "node server/src/seedAdmin.js",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^8.2.2",
    "vite": "^8.2.2"
  }
}
